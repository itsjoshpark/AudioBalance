{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "es",
      "fr",
      "it",
      "ja",
      "ko",
      "pt-BR",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "files": [
    { "kind": "folder", "path": "AudioBalance", "target-membership": [ "AudioBalance" ] },
    { "kind": "folder", "path": "AudioBalanceAgent", "target-membership": [ "AudioBalanceAgent" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "AudioBalance", "AudioBalanceAgent", "AudioBalanceTests", "AudioBalanceUITests" ] },
    { "kind": "folder", "path": "Icon", "target-membership": [ "AudioBalance", "AudioBalanceAgent" ] },
    { "kind": "folder", "path": "AudioBalanceTests", "target-membership": [ "AudioBalanceTests" ] },
    { "kind": "folder", "path": "AudioBalanceUITests", "target-membership": [ "AudioBalanceUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Audio Balance.app", "id": "AB0000000000000000000010", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Audio Balance Agent.app", "id": "AB0000000000000000000011", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "AudioBalance/copy/Embed Login Item", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/AudioBalanceTests.xctest", "id": "AB0000000000000000000012", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AudioBalanceUITests.xctest", "id": "AB0000000000000000000014", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "AudioBalance",
      "id": "AB0000000000000000000030",
      "product": "Products/Audio Balance.app",
      "product-type": "application",
      "dependencies": [
        "AudioBalanceAgent",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Login Item",
          "bundle-base-path": "root",
          "relative-path": "Contents/Library/LoginItems",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "AudioBalance/AudioBalance.entitlements",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Audio Balance",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright © 2026 Joshua Park",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.joshuapark.AudioBalance",
        "PRODUCT_MODULE_NAME": "AudioBalance",
        "PRODUCT_NAME": "Audio Balance",
      },
    }, {
      "name": "AudioBalanceAgent",
      "id": "AB0000000000000000000031",
      "product": "Products/Audio Balance Agent.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "AudioBalanceAgent/AudioBalanceAgent.entitlements",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Audio Balance",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright © 2026 Joshua Park",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.joshuapark.AudioBalance.Agent",
        "PRODUCT_MODULE_NAME": "AudioBalanceAgent",
        "PRODUCT_NAME": "Audio Balance Agent",
        "SKIP_INSTALL": "YES",
      },
    }, {
      "name": "AudioBalanceTests",
      "id": "AB0000000000000000000032",
      "product": "Products/AudioBalanceTests.xctest",
      "product-type": "bundle.unit-test",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.joshuapark.AudioBalance.Tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    }, {
      "name": "AudioBalanceUITests",
      "id": "AB0000000000000000000033",
      "product": "Products/AudioBalanceUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "AudioBalance",
      "dependencies": [
        "AudioBalance",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ENABLE_APP_SANDBOX": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.joshuapark.AudioBalance.UITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_TARGET_NAME": "AudioBalance",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "18",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "TCQ6328PP6",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "15.0",
    "MARKETING_VERSION": "1.0.2",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
    "SWIFT_EMIT_LOC_STRINGS": "YES",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
    "SWIFT_VERSION": "5.0",
  },
