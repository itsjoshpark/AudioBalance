    "Audio Balance" : {
      "comment" : "App name; not translated.",
      "shouldTranslate" : false
    },
    "Audio Balance is registered but isn't running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance ist registriert, wird aber nicht ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance está registrado, pero no se está ejecutando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance est enregistré, mais ne fonctionne pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance è registrato ma non è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balanceは登録されていますが、実行されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance가 등록되어 있지만 실행되고 있지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Audio Balance está registrado, mas não está em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance 已注册，但未在运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance 已註冊，但未在執行。"
          }
        }
      }
    },
    "Audio Balance is turned off in Login Items & Extensions. Allow it in System Settings to keep your balance locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance ist unter „Anmeldeobjekte & Erweiterungen“ deaktiviert. Erlaube es in den Systemeinstellungen, damit die Balance fixiert bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance está desactivado en Ítems de inicio y extensiones. Permítelo en Ajustes del Sistema para mantener fijo el balance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance est désactivé dans Ouverture et extensions. Autorisez-le dans Réglages Système pour garder la balance verrouillée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance è disattivato in Elementi login ed estensioni. Consentilo in Impostazioni di Sistema per mantenere bloccato il bilanciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balanceは「ログイン項目と機能拡張」でオフになっています。バランスを固定し続けるには、「システム設定」で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance가 로그인 항목 및 확장 프로그램에서 꺼져 있습니다. 밸런스를 계속 고정하려면 시스템 설정에서 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Audio Balance está desativado em Itens de Início de Sessão e Extensões. Permita-o nos Ajustes do Sistema para manter o balanço fixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance 已在“登录项与扩展”中关闭。请在“系统设置”中允许它，以保持声道平衡锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance 已在「登入項目與延伸功能」中關閉。請在「系統設定」中允許它，以保持聲道平衡鎖定。"
          }
        }
      }
    },
    "Audio Balance keeps running in the background after you close this window. Manage it in System Settings › General › Login Items & Extensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance läuft im Hintergrund weiter, nachdem du dieses Fenster geschlossen hast. Verwalte es unter „Systemeinstellungen“ › „Allgemein“ › „Anmeldeobjekte & Erweiterungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance sigue ejecutándose en segundo plano después de cerrar esta ventana. Puedes gestionarlo en Ajustes del Sistema › General › Ítems de inicio y extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance continue de fonctionner en arrière-plan après la fermeture de cette fenêtre. Gérez-le dans Réglages Système › Général › Ouverture et extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Balance continua a funzionare in background dopo la chiusura di questa finestra. Puoi gestirlo in Impostazioni di Sistema › Generali › Elementi login ed estensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウを閉じた後も、Audio Balanceはバックグラウンドで動作し続けます。「システム設定」›「一般」›「ログイン項目と機能拡張」で管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 윈도우를 닫은 후에도 Audio Balance는 백그라운드에서 계속 실행됩니다. 시스템 설정 › 일반 › 로그인 항목 및 확장 프로그램에서 관리할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Audio Balance continua em execução em segundo plano depois que você fecha esta janela. Gerencie-o em Ajustes do Sistema › Geral › Itens de Início de Sessão e Extensões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此窗口后，Audio Balance 会继续在后台运行。你可以在“系统设置”›“通用”›“登录项与扩展”中管理它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉此視窗後，Audio Balance 會繼續在背景執行。你可以在「系統設定」›「一般」›「登入項目與延伸功能」中管理。"
          }
        }
      }
    },
    "Audio Balance re-centered %@." : {
      "localizations" : {
        "de" : {
