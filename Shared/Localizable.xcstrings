    "Keeps your left–right balance locked, even when AirPods or other devices drift." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Links-Rechts-Balance fest, auch wenn AirPods oder andere Geräte abweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene fijo el balance izquierda-derecha, incluso cuando los AirPods u otros dispositivos se desajustan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouille la balance gauche-droite, même lorsque les AirPods ou d’autres appareils se dérèglent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene bloccato il bilanciamento sinistra-destra, anche quando gli AirPods o altri dispositivi lo alterano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsなどのデバイスでずれが生じても、左右のバランスを固定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods 또는 다른 기기에서 밸런스가 틀어져도 좌우 밸런스를 고정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o balanço entre esquerda e direita fixo, mesmo quando os AirPods ou outros dispositivos se desajustam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使 AirPods 或其他设备出现偏移，也能锁定左右声道平衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使 AirPods 或其他裝置出現偏移，也能鎖定左右聲道平衡。"
          }
        }
      }
    },
